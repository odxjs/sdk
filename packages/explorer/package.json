{
  "name": "@odxjs/explorer",
  "type": "module",
  "version": "0.0.1",
  "private": false,
  "description": "Standalone Nuxt DevTools and operations UI for ODX.",
  "license": "MIT",
  "homepage": "https://github.com/odxjs/sdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/odxjs/sdk.git",
    "directory": "packages/explorer"
  },
  "exports": {
    ".": "./nuxt.config.ts",
    "./client-manifest": "./dist/client/manifest.json",
    "./package.json": "./package.json"
  },
  "main": "./nuxt.config.ts",
  "files": [
    "LICENSE",
    "README.md",
    "app.config.ts",
    "app.css",
    "app.vue",
    "components",
    "composables",
    "dist/client",
    "nuxt.config.ts",
    "scripts",
    "utils"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "nuxi dev",
    "generate": "nuxi generate",
    "prepare": "nuxi prepare",
    "preview": "nuxi preview",
    "verify": "vitest run && pnpm run typecheck",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "nuxi typecheck",
    "prepack": "pnpm run build && pnpm run verify"
  },
  "peerDependencies": {
    "nuxt": "^4.6.3",
    "vue": "^3.5.44"
  },
  "dependencies": {
    "@odxjs/core": "workspace:*",
    "@nuxt/ui": "4.12.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "14.2.1",
    "elkjs": "^0.11.1",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.4",
    "@vue/test-utils": "^2.4.6",
    "nuxt": "4.6.3",
    "typescript": "~5.9.3",
    "vitest": "4.1.3",
    "vue": "3.5.44",
    "vue-tsc": "3.2.6"
  }
}
