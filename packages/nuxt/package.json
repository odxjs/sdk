{
  "name": "@odxjs/nuxt",
  "type": "module",
  "version": "0.0.1",
  "private": false,
  "description": "Nuxt module for type-safe OData access, SDK generation, proxying, and DevTools integration.",
  "license": "MIT",
  "homepage": "https://github.com/odxjs/sdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/odxjs/sdk.git",
    "directory": "packages/nuxt"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    },
    "./generate": {
      "types": "./dist/generate.d.mts",
      "import": "./dist/generate.mjs",
      "default": "./dist/generate.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "generate": [
        "./dist/generate.d.mts"
      ],
      "server": [
        "./dist/server.d.mts"
      ]
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "scripts": {
    "dev": "nuxi dev test/fixtures/isolated",
    "playground:check": "nuxi prepare playground/minimal && node playground/minimal/verify.mjs",
    "prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare test/fixtures/isolated",
    "test": "vitest run",
    "test:live:northwind": "vitest run --config vitest.live.config.ts",
    "test:explorer-consumer": "tsx test/verify-explorer-consumer.mts",
    "test:explorer-native": "tsx test/verify-explorer-native.mts",
    "test:explorer-startup": "tsx test/verify-explorer-startup.mts",
    "verify": "vitest run && pnpm run playground:check",
    "build": "nuxt-module-build build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm run build && pnpm run verify",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare"
  },
  "peerDependencies": {
    "vue": "^3.5.39"
  },
  "dependencies": {
    "@odxjs/core": "workspace:*",
    "@odxjs/metadata": "workspace:*",
    "@odxjs/proxy": "workspace:*",
    "@nuxt/devtools-kit": "4.0.0",
    "@nuxt/kit": "4.6.3",
    "@nuxt/schema": "4.6.3",
    "@odata2ts/odata2ts": "^0.40.1",
    "consola": "3.4.2",
    "h3": "1.15.11",
    "nitropack": "2.13.4",
    "ofetch": "^1.5.1",
    "pathe": "2.0.3",
    "sirv": "3.0.2"
  },
  "devDependencies": {
    "@odxjs/explorer": "workspace:*",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^26.1.1",
    "@vitejs/devtools-kit": "0.8.0",
    "nuxt": "^4.6.3",
    "playwright-core": "^1.58.2",
    "tsx": "4.21.0",
    "typescript": "~5.9.3",
    "unbuild": "3.6.1",
    "vite": "8.3.5",
    "vitest": "4.1.3",
    "vue": "3.5.44"
  }
}
